# Template for .env — run `make env` to create .env with generated secrets.
# Never commit .env. New keys added here are appended to an existing .env by `make env`.

# development | test | production (docker-compose forces production for the backend container)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Public URL prefix, without trailing slash (ADR-0011). Leave empty to serve at the root.
# Baked into the frontend build: run `make deploy` after changing it.
BASE_PATH=/work-orchestrator

# Port published on 127.0.0.1 by the frontend container; point your external nginx here.
APP_PORT=18080

POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=orchestrator

# Host-side access to the development database (docker-compose.dev.yml, 127.0.0.1 only).
# Inside Docker the backend always uses db:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Signing key for authentication tokens (ADR-0007).
SECRET_KEY=__GENERATE__

# Comma-separated origins allowed by CORS. Empty = same-origin only (normal deployment).
# The Vite dev server proxies /api, so CORS is not needed in development either.
CORS_ORIGINS=
