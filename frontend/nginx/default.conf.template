# Rendered at container start by the nginx image (envsubst on ${BASE_PATH} only).
# BASE_PATH is "" (root) or "/segment" without trailing slash (ADR-0011).

# Keep the scheme/host sent by the external reverse proxy; fall back to ours.
map $http_x_forwarded_proto $wo_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
map $http_x_forwarded_host $wo_forwarded_host {
    default $http_x_forwarded_host;
    ""      $http_host;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    # Relative redirects: "/work-orchestrator" -> "/work-orchestrator/" keeps the public host.
    absolute_redirect off;
    root /usr/share/nginx/html;

    include /etc/nginx/snippets/security-headers.conf;

    location ${BASE_PATH}/api/ {
        # Strip BASE_PATH: backend routes start at /api (uvicorn --root-path handles URLs).
        proxy_pass http://backend:8000/api/;
        include /etc/nginx/snippets/api-proxy.conf;
        client_max_body_size 25m;
    }

    # Imports take bigger bodies than other uploads; the backend enforces the exact limits
    # (archive 200 MB, Markdown 50 MB, ADR-0040).
    location = ${BASE_PATH}/api/v1/import {
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_pass http://backend:8000/api/v1/import;
        client_max_body_size 210m;
        proxy_read_timeout 300s;
    }

    location = ${BASE_PATH}/api/v1/documents/import-markdown {
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_pass http://backend:8000/api/v1/documents/import-markdown;
        client_max_body_size 55m;
        proxy_read_timeout 300s;
    }

    location ${BASE_PATH}/assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ${BASE_PATH}/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        # SPA fallback: deep links are resolved by the client router.
        try_files $uri $uri/ ${BASE_PATH}/index.html;
    }
}
